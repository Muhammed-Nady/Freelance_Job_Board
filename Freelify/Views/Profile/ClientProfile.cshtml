@model Freelify.Models.ViewModels.Profile.ClientProfileViewModel

@{
    ViewData["Title"] = "Client Profile";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar Card -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100 p-4 text-center">
                <div class="position-relative d-inline-block mx-auto mb-4" style="width: 140px; height: 140px;">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="@Model.FullName" class="rounded-circle border border-2 border-white shadow-sm" style="width: 140px; height: 140px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center border border-2 border-white shadow-sm" style="width: 140px; height: 140px; font-size: 3rem;">
                            @Model.FullName[0].ToString().ToUpper()
                        </div>
                    }

                    <span class="position-absolute bg-success border border-white rounded-circle p-2" style="top: 5px; right: 5px; z-index: 5;" title="Active Account"></span>
                </div>

                <h3 class="fw-bold mb-1">
                    @Model.FullName
                </h3>

                <p class="text-muted mb-2">
                    <span class="badge bg-primary px-3 py-2 rounded-pill">
                        Client
                    </span>
                </p>

                <div class="mb-3">
                    <div class="text-warning fs-5 d-inline-block">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.AverageRating))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }
                    </div>
                    <span class="fw-bold fs-6 ms-1">@Model.AverageRating.ToString("F1")</span>
                    <span class="text-muted small">(@Model.ReviewCount reviews)</span>
                </div>

                <hr class="my-3 text-muted">

                <div class="text-start">
                    <div class="d-flex align-items-center mb-3">
                        <div class="flex-shrink-0 bg-light rounded-circle p-2 text-primary me-3">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted d-block small">Email Address</span>
                            <span class="fw-semibold text-break">@Model.Email</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <div class="flex-shrink-0 bg-light rounded-circle p-2 text-primary me-3">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted d-block small">Phone Number</span>
                            <span class="fw-semibold">@Model.PhoneNumber</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <div class="flex-shrink-0 bg-light rounded-circle p-2 text-primary me-3">
                            <i class="bi bi-calendar-event-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted d-block small">Member Since</span>
                            <span class="fw-semibold">@Model.CreatedDate.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4 pt-2">
                    <a asp-action="Edit" class="btn btn-primary d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-pencil-square"></i> Edit Profile
                    </a>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-lock-fill"></i> Change Password
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Details -->
        <div class="col-lg-8">
            <div class="d-flex flex-column gap-4 h-100">
                <!-- Company Information Card -->
                <div class="card shadow-sm border-0 p-4">
                    <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                        <h4 class="fw-bold text-primary mb-0">
                            <i class="bi bi-building-fill me-2"></i>
                            Company Information
                        </h4>
                    </div>

                    <!-- Company Logo -->
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.CompanyLogoUrl))
                        {
                            <img src="@Model.CompanyLogoUrl"
                                 alt="@Model.CompanyName"
                                 class="rounded shadow-sm border"
                                 style="width:90px;height:90px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light border rounded d-inline-flex justify-content-center align-items-center"
                                 style="width:80px;height:80px;">
                                <i class="bi bi-building fs-1 text-secondary"></i>
                            </div>
                        }
                    </div>

                    <!-- Company Name -->
                    <h3 class="fw-bold text-center mb-4">
                        @Model.CompanyName
                    </h3>

                    <div class="border-top pt-4">
                        <h6 class="text-uppercase text-muted fw-semibold mb-3">
                            Company Description
                        </h6>
                        <p class="style-paragraph mb-0" style="white-space: pre-wrap;">
                            @Model.CompanyDescription
                        </p>
                    </div>
                </div>

                <!-- Reviews Card -->
                <div class="card shadow-sm border-0 p-4">
                    <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                        <h4 class="fw-bold m-0 text-primary d-flex align-items-center gap-2">
                            <i class="bi bi-star-fill text-warning"></i> Freelancer Reviews (@Model.ReviewCount)
                        </h4>
                    </div>

                    @if (Model.Reviews.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="p-3 bg-light rounded-3 border-start border-4 border-warning shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-bold text-dark">@review.ReviewerName</div>
                                        <div class="text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="small text-muted mb-2">Job: <span class="fw-semibold">@review.JobTitle</span></div>
                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <p class="mb-0 text-secondary style-paragraph" style="white-space: pre-wrap;">@review.Comment</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No reviews received yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fs-7 {
            font-size: 0.85rem;
        }
        .style-paragraph {
            font-size: 1.05rem;
            color: #4a5568 !important;
        }
        .btn-outline-secondary {
            border-color: #cbd5e0;
            color: #4a5568;
        }
        .btn-outline-secondary:hover {
            background-color: #f7fafc;
            color: #2d3748;
            border-color: #a0aec0;
        }
    </style>
}
